.specify/*
.claude/skills/spec*

# Node / Vite
app/node_modules/
app/dist/
app/dev-dist/
app/*.log
app/.env*

# Test output
app/test-results/
app/playwright-report/
app/coverage/

# Local environment — never commit
.env
.env.*
!.env.example

# Built release artifacts — reproducible from a tagged commit, so not worth versioning.
# The folder's README stays tracked so the process is documented where the builds land.
release/*
!release/README.md

# Signing secrets — never commit an upload key or its passwords
app/android/keystore.properties
*.jks
*.keystore

# Capacitor native build output (the platform projects themselves stay committed)
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/local.properties
app/ios/App/Pods/
app/ios/App/build/
app/ios/DerivedData/

# Jekyll build output for the GitHub Pages site. Regenerated from the sources on every build, and
# it copies the whole repository into itself — 317 MB and thousands of files as of this writing.
# (.jekyll-cache/ already excludes itself through a .gitignore Jekyll writes inside it.)
_site/
.jekyll-cache/

# Python
__pycache__/
*.pyc
.venv/

# Universal
.DS_Store
Thumbs.db
*.swp
.env

