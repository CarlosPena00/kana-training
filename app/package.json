{
  "name": "kana-flashcards",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Offline flashcards for learning Japanese Hiragana and Katakana. Android, iOS, and Web from one codebase.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && tsc --noEmit",
    "android:aab": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "android:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "store:assets": "python3 scripts/make-store-assets.py"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "happy-dom": "20.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
