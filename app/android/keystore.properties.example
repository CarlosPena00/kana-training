# Copy to android/keystore.properties and fill in. That file is gitignored: an upload key is a
# secret, and losing it (or leaking it) means you can no longer publish updates to your listing.
#
# Create the keystore first:
#
#   keytool -genkeypair -v \
#     -keystore ~/kana-flashcards-upload.jks \
#     -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file and these passwords backed up somewhere you will still have in five years.

storeFile=/absolute/path/to/kana-flashcards-upload.jks
storePassword=
keyAlias=upload
keyPassword=
