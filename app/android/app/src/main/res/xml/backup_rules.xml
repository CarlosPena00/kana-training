<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 counterpart to data_extraction_rules.xml. Referenced by
  android:fullBackupContent so the same exclusion holds on API 24-30, where
  <data-extraction-rules> is ignored (003 FR-032).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
